# Copia este archivo como .env y llena los valores (Supabase → Project Settings → API).
# Son los MISMOS que usa la app de Android en local.properties.
# La llave "anon" es pública; nunca pongas aquí la service_role.
VITE_SUPABASE_URL=https://<proyecto>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon / publishable key>
